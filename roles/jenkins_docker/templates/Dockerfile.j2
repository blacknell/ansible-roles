# {{ ansible_managed }}
FROM {{ jenkins_docker_image }}
{% if jenkins_docker_apt_packages | length > 0 %}

USER root
RUN apt-get update && \
    apt-get install -y \
{% for package in jenkins_docker_apt_packages %}
        {{ package }} \
{% endfor %}
    && apt-get clean
USER jenkins
{% endif %}
{% if jenkins_docker_plugins | length > 0 %}

COPY plugins.txt /usr/share/jenkins/ref/plugins.txt
RUN jenkins-plugin-cli --plugin-file /usr/share/jenkins/ref/plugins.txt
{% endif %}
