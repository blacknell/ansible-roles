port     = http,https
filter   = apache-badbots
backend  = auto
logpath  = %(apache_error_logpath)s
bantime = 1d
{{ jail_actions('18,19', '256', 'WEB', slack=true) | trim }}

[apache-nohome]
enabled = {{ fail2ban_apache_jails_enabled | bool | lower }}
port     = http,https
filter   = apache-nohome
backend  = auto
logpath  = %(apache_error_logpath)s
bantime = 1d
{{ jail_actions('18', '8', 'WEB', slack=true) | trim }}

[apache-404]
enabled = {{ fail2ban_apache_jails_enabled | bool | lower }}
port = http,https
filter = apache-404
backend  = auto
logpath  = %(apache_access_logpath)s
bantime = 1h
findtime = 10m
maxretry = 5
