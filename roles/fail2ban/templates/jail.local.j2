{{ jail_actions('21', '8', 'WEBAPP') | trim }}

[repeat-offenders]
enabled  = {{ fail2ban_enable_repeat_offenders_jail | bool | lower }}
filter    = recidive
logpath   = /var/log/fail2ban.log
banaction = %(banaction_allports)s
bantime   = 4w
findtime  = 28d
maxretry  = 2
action = %(action_)s
{% if fail2ban_slack_bot_token | length > 0 and fail2ban_slack_channel | length > 0 %}
         %(action_slack_chatmsg)s[slack_bot_token="{{ fail2ban_slack_bot_token }}", slack_channel="{{ fail2ban_slack_channel }}"]
{% endif %}
{% if fail2ban_xarf_sender | length > 0 %}
         %(action_xarf_report)s[sender="{{ fail2ban_xarf_sender }}", bcc="{{ fail2ban_xarf_sender }}", service="http", port="443"]
{% endif %}
{{ mqtt_action() }}
